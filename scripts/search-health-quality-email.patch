+function detectExpectedAudience(query: unknown): string | null {
+  const text = String(query ?? "").toLowerCase();
+  if (/\b(teen|teens|teenage|teenager|teenagers|teenage son|teenage daughter|my son|my daughter)\b/.test(text)) return "teen";
+  if (/\b(kid|kids|child|children)\b/.test(text)) return "kids";
+  if (/\b(family|family friendly|all ages)\b/.test(text)) return "family";
+  return null;
+}
+
+function deriveQualityEvaluation(args: LoggerArgs, result: any, debug: any, rawQuery: unknown) {
+  const explicit = debug?.qualityEvaluation ?? result?.qualityEvaluation ?? {};
+  const expectedAudience = explicit.expectedAudience ?? detectExpectedAudience(rawQuery);
+  const detectedAudience = explicit.detectedAudience ?? debug?.normalizedIntent?.audience?.type ?? result?.normalizedIntent?.audience?.type ?? null;
+  const locations = [
+    ...(Array.isArray(result?.activities) ? result.activities : []),
+    ...(Array.isArray(result?.matched_locations) ? result.matched_locations : []),
+  ].filter(Boolean);
+  const unique = Array.from(new Map(locations.map((row: any) => [String(row?.id ?? row?.name ?? Math.random()), row])).values());
+  const topFive = unique.slice(0, 5);
+  const topThree = unique.slice(0, 3);
+  const recordText = (row: any) => [row?.name, row?.activity_name, row?.activity_type, row?.primary_category, ...(Array.isArray(row?.tags) ? row.tags : []), ...(Array.isArray(row?.intent_tags) ? row.intent_tags : []), row?.search_document].filter(Boolean).join(" ").toLowerCase();
+  const isAdult = (row: any) => /\b(21\+|adults only|nightclub|night club|hookah|shisha|late night|bar|nightlife|club)\b/.test(recordText(row));
+  const isRelevant = (row: any) => /\b(arcade|games?|bowling|museum|mini golf|escape room|interactive|workshop|diy|park|all ages|family)\b/.test(recordText(row));
+  const adultTopFive = topFive.filter(isAdult);
+  const adultTopThree = topThree.filter(isAdult);
+  const relevantTopFive = topFive.filter(isRelevant);
+  const genericIntentCount = topFive.filter((row: any) => String(row?.primary_intent ?? "general") === "general" && Number(row?.intent_boost ?? 0) === 0).length;
+  const conflictingBoostCount = topFive.filter((row: any) => Array.isArray(row?.activityQualityReasons) && row.activityQualityReasons.some((reason: unknown) => /nightlife signal|drinks\/lounge/i.test(String(reason)))).length;
+  const flags = safeStringArray(explicit.suspiciousFlags, 50);
+  if (expectedAudience && !detectedAudience) flags.push("minor_audience_not_applied");
+  if (expectedAudience && adultTopThree.length) flags.push("adult_oriented_result_in_top_three");
+  else if (expectedAudience && adultTopFive.length) flags.push("adult_oriented_result_in_top_five");
+  if (expectedAudience && topFive.length > 0 && genericIntentCount === topFive.length) flags.push("generic_intent_used_for_specific_audience");
+  if (expectedAudience && conflictingBoostCount > 0) flags.push("nightlife_reward_applied_to_minor_query");
+  const suspiciousFlags = Array.from(new Set(flags));
+  const critical = suspiciousFlags.some((flag) => ["adult_oriented_result_in_top_three", "nightlife_reward_applied_to_minor_query", "adult_only_result_returned"].includes(flag));
+  const high = suspiciousFlags.some((flag) => ["minor_audience_not_applied", "generic_intent_used_for_specific_audience", "adult_oriented_result_in_top_five"].includes(flag));
+  const severity = explicit.severity ?? (critical ? "critical" : high ? "high" : suspiciousFlags.length ? "medium" : "none");
+  const qualitySuccess = explicit.qualitySuccess ?? !["high", "critical"].includes(String(severity));
+  return {
+    technicalSuccess: explicit.technicalSuccess ?? true,
+    qualitySuccess,
+    hadIssue: explicit.hadIssue ?? suspiciousFlags.length > 0,
+    severity,
+    issueType: explicit.issueType ?? (expectedAudience && suspiciousFlags.length ? "audience_safety_mismatch" : null),
+    issueLabel: explicit.issueLabel ?? (expectedAudience && suspiciousFlags.length ? "Minor-focused search returned conflicting results" : null),
+    suspiciousFlags, expectedAudience, detectedAudience,
+    adultOrientedTopFiveCount: adultTopFive.length,
+    relevantTopFiveCount: relevantTopFive.length,
+    genericIntentResultCount: genericIntentCount,
+    conflictingPositiveBoostCount: conflictingBoostCount,
+    topResultCategories: topFive.map((row: any) => row?.primary_category ?? row?.activity_type ?? null).filter(Boolean),
+  };
+}
