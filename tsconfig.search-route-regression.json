{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".tmp-test/search-route",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "strict": false,
    "baseUrl": "."
  },
  "include": [
    "scripts/search-route-regression.ts",
    "app/api/generate/route.ts",
    "lib/search/enterprise/**/*.ts",
    "lib/search/**/*.ts",
    "lib/supabaseAdmin.ts",
    "lib/locationImage.ts",
    "lib/publicCardImage.ts",
    "lib/search/createSearch.ts",
    "lib/search/enterprise/searchEventLogger.ts",
    "lib/search/enterprise/searchHealthLogger.ts",
    "lib/outings/parse-planned-time.ts",
    "lib/search/performance.ts"
  ]
}
