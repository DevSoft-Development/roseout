{
  "expo": {
    "name": "TheOutHaven",
    "slug": "theouthaven",
    "scheme": "theouthaven",
    "version": "0.1.2",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://updates.theouthaven.com/api/mobile/ota/manifest",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theouthaven.app",
      "icon": "./assets/app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:outhvn.com"
      ]
    },
    "android": {
      "package": "com.theouthaven.app",
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#070303"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "outhvn.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TheOutHaven to use your location to find outings near you."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "outing-reminders"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#070303"
  }
}
