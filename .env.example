
# Fast model used for search intent parsing/enhancement.
# Keep this cheaper/faster than the fallback model.
SEARCH_INTENT_FAST_MODEL=gpt-4o-mini

# Larger model used only for complex fallback interpretation if the fast model fails.
SEARCH_INTENT_FALLBACK_MODEL=gpt-4o

# Max time to wait for fast LLM intent enhancement before using preIntent fallback.
SEARCH_INTENT_LLM_TIMEOUT_MS=1400

# Max time to wait for larger fallback model when no usable preIntent exists.
SEARCH_INTENT_FALLBACK_TIMEOUT_MS=2200

# Bump this when changing intent parsing behavior so stale cached intents are avoided.
SEARCH_INTENT_CACHE_VERSION=intent-v4-fast-model
