+describe("Search Health quality mismatch detection", () => {
+  it("flags a technically successful teen search that ranks adult nightlife", () => {
+    const input = {
+      source: "public_create_search",
+      rawQuery: "Fun activities with my teenage son in queens",
+      needsActivity: true,
+      result: {
+        activities: [
+          { id: "nightlife-1", name: "Singing Karaoke Club", primary_category: "nightlife", activity_type: "nightlife", tags: ["club", "karaoke"], primary_intent: "general", intent_boost: 0, activityQualityReasons: ["drinks/lounge/nightlife signal +20"] },
+          { id: "arcade-1", name: "Gatcha", primary_category: "games", tags: ["arcade"], primary_intent: "general", intent_boost: 0 },
+        ],
+        restaurants: [], pairs: [],
+      },
+      debug: { normalizedIntent: { rawQuery: "Fun activities with my teenage son in queens", searchType: "activity", primaryDomain: "activity", needsActivity: true, activityIntent: { activityTerms: ["activity"] } } },
+    };
+    expect(shouldLogSearchHealthEvent(input)).toBe(true);
+    const payload = buildSearchHealthEventPayload(input);
+    expect(payload.technical_success).toBe(true);
+    expect(payload.quality_success).toBe(false);
+    expect(payload.quality_severity).toBe("critical");
+    expect(payload.quality_issue_type).toBe("audience_safety_mismatch");
+    expect(payload.expected_audience).toBe("teen");
+    expect(payload.detected_audience).toBeNull();
+    expect(payload.suspicious_flags).toEqual(expect.arrayContaining(["minor_audience_not_applied", "adult_oriented_result_in_top_three", "generic_intent_used_for_specific_audience", "nightlife_reward_applied_to_minor_query"]));
+    expect(classifySearchHealthEvent(input)).toEqual({ eventType: "audience_safety_mismatch", severity: "critical", eventLabel: "Minor-focused search returned conflicting results" });
+  });
+});
